#!/usr/bin/env bash
# Show what `mise dot apply` would change, with formatting noise removed.
#
# Usage: mise-dot-diff [TARGET ...]
#
# TARGET is a destination path (~/.claude/settings.json) or a configured
# source path (templates/claude-settings.json.tera). With no TARGET, every
# `[dotfiles]` entry that is not already applied is checked.
#
# Template targets are reconstructed from `mise dot diff` and JSON is compared
# in canonical (`jq -S`) form. Nothing is written; apply commands are printed.
# With --pull, live-only edits of one target are merged into the machine
# overlay (printed by default, written with --write; --into overrides the path).
# :module: mise-diff skill helper
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: mise-dot-diff [--pull [--write] [--into FILE]] [TARGET ...]

TARGET is a destination path or a configured source path. With no TARGET,
every [dotfiles] entry not in state applied is checked.

Default: print the canonical diff per drifting entry plus apply commands.
--pull:  print the live-only changes merged into the machine overlay.
         --write saves the overlay; --into FILE overrides its default path.
EOF
}

self_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$self_dir/../../../.." && pwd)"
[[ -f "$repo_root/mise.toml" ]] || {
  printf 'mise-dot-diff: expected a mise.toml at %s\n' "$repo_root" >&2
  exit 1
}
cd "$repo_root"

export NO_COLOR=1

die() {
  printf 'mise-dot-diff: %s\n' "$*" >&2
  exit 1
}

mode="diff"
write=0
into=""
positional=()
while (($# > 0)); do
  case "$1" in
    --pull) mode="pull" ;;
    --write) write=1 ;;
    --into)
      shift
      into="${1:-}"
      [[ -n "$into" ]] || die "--into requires a path"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      while (($# > 0)); do
        positional+=("$1")
        shift
      done
      break
      ;;
    *) positional+=("$1") ;;
  esac
  shift
done
set -- "${positional[@]+"${positional[@]}"}"
if [[ "$mode" != "pull" ]]; then
  ((write)) && die "--write requires --pull"
  [[ -z "$into" ]] || die "--into requires --pull"
fi

for tool in mise jq patch; do
  command -v "$tool" >/dev/null || die "$tool not found in PATH"
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

expand_tilde() { printf '%s' "${1/#\~/$HOME}"; }

if ! status="$(mise dot status -J 2>"$tmp/status.err")"; then
  cat "$tmp/status.err" >&2
  die "mise dot status failed"
fi

entries="$(printf '%s' "$status" | jq -r '(.files // [])[] | [.target, .source, .mode, .state] | @tsv')"

resolve_spec() { # user-supplied path -> "target<TAB>source<TAB>mode"
  local want="$1" expanded target source entry_mode state
  expanded="$(expand_tilde "$want")"
  [[ "$expanded" != /* ]] && expanded="$repo_root/$want"
  while IFS=$'\t' read -r target source entry_mode state; do
    [[ -z "$target" ]] && continue
    if [[ "$target" == "$want" || "$source" == "$want" ||
      "$(expand_tilde "$target")" == "$expanded" ||
      "$(expand_tilde "$source")" == "$expanded" ]]; then
      printf '%s\t%s\t%s\n' "$target" "$source" "$entry_mode"
      return 0
    fi
  done <<<"$entries"
  return 1
}

specs=()
in_specs() {
  local needle="$1" s
  for s in "${specs[@]+"${specs[@]}"}"; do
    [[ "$s" == "$needle" ]] && return 0
  done
  return 1
}

if (($# > 0)); then
  for want in "$@"; do
    spec="$(resolve_spec "$want")" || die "no [dotfiles] entry matches '$want' (try: mise dot status)"
    in_specs "$spec" || specs+=("$spec")
  done
else
  while IFS=$'\t' read -r target source entry_mode state; do
    [[ -z "$target" || "$state" == "applied" ]] && continue
    specs+=("$target"$'\t'"$source"$'\t'"$entry_mode")
  done <<<"$entries"
fi

if ((${#specs[@]} == 0)); then
  echo "mise-dot-diff: all configured dotfiles are applied; nothing to change."
  exit 0
fi

if [[ "$mode" == "pull" ]] && ((${#specs[@]} != 1)); then
  die "--pull handles one target at a time"
fi

normalize_json() { # empty input stays empty; non-JSON passes through
  if [[ -s "$1" ]] && jq -e . "$1" >/dev/null 2>&1; then
    jq -S . "$1"
  else
    cat "$1"
  fi
}

pull_overlay() {
  local target="$1" source="$2" cur="$3" desired="$4" cur_json="$5" desired_json="$6" into="$7" do_write="$8"
  local overlay="$into" result patch deletions

  [[ -e "$cur" ]] || die "--pull requires the live target to exist ($target)"
  jq -e . "$cur" >/dev/null 2>&1 || die "--pull requires the live target to be JSON ($target)"
  jq -e . "$desired" >/dev/null 2>&1 || die "--pull requires a JSON template ($target)"

  if [[ -z "$overlay" ]]; then
    if [[ "$source" == */templates/claude-settings.json.tera ]]; then
      overlay="$HOME/.config/claude/settings-overlay.json"
    else
      die "--pull needs --into <overlay-file> for $target"
    fi
  fi

  result="$(jq -n --slurpfile live "$cur_json" --slurpfile desired "$desired_json" '
    def changes($l; $d):
      if (($l|type) == "object") and (($d|type) == "object") then
        (reduce ($l|keys[]) as $k ({};
           (if ($d|has($k)) then changes($l[$k]; $d[$k]) else {changed: true, value: $l[$k]} end) as $c
           | if $c.changed then . + {($k): $c.value} else . end)) as $p
        | {changed: ($p|length) > 0, value: $p}
      else {changed: $l != $d, value: $l} end;
    (changes($live[0]; $desired[0])) as $c
    | {patch: (if $c.changed then $c.value else {} end),
       deletions: [ $desired[0] | paths as $p
                    | select(($p | length) > 0)
                    | select(($live[0] | (try (getpath($p[:-1]) | has($p[-1])) catch false)) == false)
                    | select(($live[0] | (try getpath($p[:-1]) catch null)) != null)
                    | {path: ($p|join(".")), value: ($desired[0]|getpath($p))} ]}
  ')"

  patch="$(jq -c '.patch' <<<"$result")"
  deletions="$(jq -r '.deletions[]? | "- \(.path) = \(.value | tojson)"' <<<"$result")"

  if [[ "$patch" == "{}" ]]; then
    printf '   no live-only changes to pull\n'
  else
    printf '   live-only changes:\n'
    jq -S '.patch' <<<"$result" | sed 's/^/   /'
    if [[ -f "$overlay" ]]; then
      jq -e . "$overlay" >/dev/null 2>&1 || die "overlay is not valid JSON: $overlay"
      jq -S -n --argjson o "$(jq -S . "$overlay")" --argjson p "$patch" '$o * $p' >"$tmp/overlay.new"
    else
      jq -S . <<<"$patch" >"$tmp/overlay.new"
    fi
    if ((do_write)); then
      mkdir -p -- "$(dirname -- "$overlay")"
      cp "$tmp/overlay.new" "$overlay"
      printf '   wrote overlay: %s\n' "$overlay"
    else
      printf '   overlay would become (%s):\n' "$overlay"
      sed 's/^/   /' "$tmp/overlay.new"
    fi
  fi

  if [[ -n "$deletions" ]]; then
    printf '   template-owned keys absent from live (apply restores them; edit the template to remove them for good):\n'
    printf '%s\n' "$deletions" | sed 's/^/   /'
  fi

  if [[ "$patch" != "{}" || -n "$deletions" ]]; then
    printf '   apply: mise dot apply %s\n' "$target"
  fi
}

changed=()
failed=0

for spec in "${specs[@]}"; do
  IFS=$'\t' read -r target source entry_mode <<<"$spec"
  [[ "$mode" == "pull" && "$entry_mode" != "template" ]] &&
    die "--pull supports template targets only ($target is $entry_mode)"
  printf '\n== %s (%s)\n' "$target" "$entry_mode"
  printf '   source: %s\n' "$source"

  if ! mise dot diff "$target" >"$tmp/out" 2>"$tmp/err"; then
    printf '   mise could not render this entry:\n'
    sed 's/^/   /' "$tmp/err"
    failed=1
    continue
  fi

  if ! grep -q '^--- ' "$tmp/out"; then
    if grep -qi 'differs' "$tmp/out"; then
      sed 's/^/   /' "$tmp/out"
      changed+=("$target")
    elif [[ -s "$tmp/out" ]]; then
      sed 's/^/   /' "$tmp/out"
    else
      printf '   already applied; nothing to change\n'
    fi
    continue
  fi

  sed -n '/^--- /,$p' "$tmp/out" >"$tmp/patch"

  current="$(expand_tilde "$target")"
  if [[ -e "$current" ]]; then
    cur="$current"
    cur_label="current"
  else
    : >"$tmp/empty"
    cur="$tmp/empty"
    cur_label="current (missing)"
  fi

  if ! patch -s -o "$tmp/desired" "$cur" "$tmp/patch" 2>"$tmp/patch.err"; then
    printf '   could not reconstruct the rendered file; mise diff follows:\n'
    sed 's/^/   /' "$tmp/out"
    failed=1
    continue
  fi

  normalize_json "$cur" >"$tmp/cur.norm"
  normalize_json "$tmp/desired" >"$tmp/desired.norm"

  if [[ "$mode" == "pull" ]]; then
    pull_overlay "$target" "$source" "$cur" "$tmp/desired" "$tmp/cur.norm" "$tmp/desired.norm" "$into" "$write"
    continue
  fi

  kind="diff"
  if [[ ! -s "$tmp/desired" ]] || jq -e . "$tmp/desired" >/dev/null 2>&1; then
    if [[ ! -s "$cur" ]] || jq -e . "$cur" >/dev/null 2>&1; then
      kind="canonical JSON diff (key order and formatting ignored)"
    fi
  fi

  if cmp -s "$tmp/cur.norm" "$tmp/desired.norm"; then
    printf '   no change after normalization\n'
    continue
  fi

  printf '   %s:\n' "$kind"
  diff -u --label "$cur_label" --label "desired (rendered)" \
    "$tmp/cur.norm" "$tmp/desired.norm" | sed 's/^/   /' || true

  changed+=("$target")
done

if ((${#changed[@]} > 0)); then
  printf '\nApply (nothing written yet; apply prompts, add --yes to skip):\n'
  for t in "${changed[@]}"; do
    printf '  mise dot apply %s\n' "$t"
  done
  if ((${#changed[@]} > 1)); then
    printf '  mise dot apply %s\n' "${changed[*]}"
  fi
fi

exit "$failed"
