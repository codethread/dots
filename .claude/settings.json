{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax prime",
						"statusMessage": "Beeswax onboarding v1"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system harness-alert --harness claude",
						"statusMessage": "Beeswax tracker alerts v1"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "scent system hook --harness claude",
						"statusMessage": "Beeswax identity v1"
					}
				],
				"matcher": "^(startup|resume|clear|compact)$"
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system harness-alert --harness claude",
						"statusMessage": "Beeswax tracker alerts v1"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "beeswax system harness-alert --harness claude",
						"statusMessage": "Beeswax tracker alerts v1"
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "scent system hook --harness claude",
						"statusMessage": "Beeswax identity v1"
					}
				]
			}
		]
	}
