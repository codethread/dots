{
  "name": "dots-lake",
  "private": true,
  "type": "module",
  "botlake": {
    "name": "dots",
    "extensions": [
      "@botlake/extension-batteries",
      "@botlake/extension-identity",
      "./.botlake/src/flags.ts",
      "./.botlake/src/references.ts",
      "./.botlake/src/agents.ts",
      "./.botlake/src/priming.ts",
      "./.botlake/src/work.ts",
      "./.botlake/src/work-agents.ts"
    ]
  },
  "dependencies": {
    "@botlake/core": "link:@botlake/core",
    "@botlake/native-session": "link:@botlake/native-session",
    "@botlake/extension-batteries": "link:@botlake/extension-batteries",
    "@botlake/extension-identity": "link:@botlake/extension-identity",
    "@botlake/extension-flags": "link:@botlake/extension-flags",
    "@botlake/extension-references": "link:@botlake/extension-references",
    "@botlake/extension-agents": "link:@botlake/extension-agents",
    "@botlake/extension-work": "link:@botlake/extension-work",
    "@botlake/extension-work-agents": "link:@botlake/extension-work-agents",
    "ct-config": "link:ct-config"
  }
}
