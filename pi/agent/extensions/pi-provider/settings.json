{
  "providers": [
    "openai",
    "openai-codex"
  ],
  "default": "openai-codex",
  "paths": [
    {
      "path": "~/dev",
      "provider": "openai-codex"
    },
    {
      "path": "~/.pdx",
      "provider": "openai-codex"
    },
    {
      "path": "~/pb",
      "provider": "openai"
    }
  ]
}
