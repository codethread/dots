{
  "lastChangelogVersion": "1.1.0",
  "theme": "rose-pine-dawn/rose-pine-moon",
  "quietStartup": true,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-luna",
    "deepseek/deepseek-flash"
  ],
  "defaultTools": [
    "+mcp",
    "+codemode"
  ],
  "packages": [
    {
      "source": "../../dev/projects/agents"
    },
    {
      "source": "../../pb/adam.hall/workfiles/agents/plugins/admin"
    },
    {
      "source": "../../pb/adam.hall/workfiles/agents/plugins/backend"
    },
    "npm:pi-nvim",
    "npm:@narumitw/pi-goal",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-typesafe-compact"
  ],
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "terminal": {
    "showTerminalProgress": false
  },
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "fullscreenScrollbar": "auto",
  "pies": {
    "excludeExtensions": []
  },
  "autocompleteMaxVisible": 10
}