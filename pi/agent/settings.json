{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "theme": "rose-pine-dawn/rose-pine-moon",
  "quietStartup": true,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-luna",
    "deepseek/deepseek-flash"
  ],
  "defaultTools": [
    "+fetch_content",
    "+web_search",
    "+mcp",
    "+codemode"
  ],
  "packages": [
    {
      "source": "../../dev/projects/agents"
    },
    {
      "source": "../../dev/projects/botlake/plugins/identity"
    },
    {
      "source": "../../.local/share/work-botlake-hooks/plugins/mail"
    },
    {
      "source": "../../pb/adam.hall/workfiles/agents/plugins/admin"
    },
    {
      "source": "../../pb/adam.hall/workfiles/agents/plugins/backend"
    },
    {
      "source": "../../pb/adam.hall/workfiles/agents/plugins/work-planning"
    },
    "npm:pi-nvim",
    "npm:@narumitw/pi-goal",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-typesafe-compact"
  ],
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "terminal": {
    "showTerminalProgress": false
  },
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "fullscreenScrollbar": "auto",
  "pies": {
    "excludeExtensions": []
  },
  "autocompleteMaxVisible": 10,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@narumitw/pi-goal\",\"scope\":\"user\"}": "0.55.0",
    "{\"source\":\"npm:@narumitw/pi-btw\",\"scope\":\"user\"}": "0.63.7",
    "{\"source\":\"npm:@narumitw/pi-typesafe-compact\",\"scope\":\"user\"}": "0.1.3",
    "{\"source\":\"../../dev/projects/agents\",\"scope\":\"user\"}": "0.1.0"
  }
}