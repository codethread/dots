#!/usr/bin/env bash
# :module: verify nix flake builds when nix/ files are staged

if ! git diff --cached --name-only | grep -q '^nix/'; then
	exit 0
fi

GIT_DIR="$(git rev-parse --git-dir)"
# skip during rebase — intermediate commits may be intentionally broken
if [ -d "${GIT_DIR}/rebase-merge" ] || [ -d "${GIT_DIR}/rebase-apply" ]; then
	exit 0
fi
# skip during cherry-pick sequences
if [ -f "${GIT_DIR}/CHERRY_PICK_HEAD" ]; then
	exit 0
fi

FLAKE="path:$(git rev-parse --show-toplevel)/nix"
SCRIPTS="$(git rev-parse --show-toplevel)/config/nushell/scripts"

host=$(nu -I "$SCRIPTS" -c 'use ct/nix.nu [nrs-flake-host]; nrs-flake-host')

case "$(uname -s)" in
	Darwin)  rebuild_cmd="darwin-rebuild" ;;
	Linux)   rebuild_cmd="nixos-rebuild" ;;
	*)       exit 0 ;;
esac

output=$("$rebuild_cmd" build --flake "${FLAKE}#${host}" 2>&1)
rc=$?
rm -f "$(git rev-parse --show-toplevel)/result"

if [ $rc -ne 0 ]; then
	echo "nix build failed:"
	echo "$output"
	exit 1
fi
