{# A repo may install a JSON overlay without owning this shared output file. #}
{# claude.ai connectors are off by default. disableClaudeAiConnectors is any-source-true, but this env
   default can be overridden per session: --settings '{"env":{"ENABLE_CLAUDEAI_MCP_SERVERS":"true"}}'. #}
{% set notify_plugins = {"cc-notify@cc-notify-marketplace": true} if vars.claude_enable_notify else {} %}
{% set notify_marketplaces = {"cc-notify-marketplace": {"source": {"source": "github", "repo": "codethread/cc-notify"}}} if vars.claude_enable_notify else {} %}
{% set base = {
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "MANPAGER": "cat",
    "SHELL": exec(command="command -v bash"),
    "TMPDIR": "/tmp/claude"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash",
      "Edit(.claude/**)",
      "Read(//tmp/claude/**)",
      "Edit(//tmp/claude/**)",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__context7__*"
    ],
    "deny": [
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "NotebookEdit",
      "WaitForMcpServers",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "LSP",
      "Workflow",
      "ShareOnboardingGuide",
      "DesignSync",
      "Read(**/*.key)",
      "Read(~/*.key)",
      "Read(**/*.pem)",
      "Read(~/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git/hooks/**)",
      "Read(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Read(**/.netrc)",
      "Read(~/.netrc)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.local",
      "~/.claude",
      "~/dev"
    ]
  },
  "enabledMcpjsonServers": [],
  "skillOverrides": {
    "autofix-pr": "off",
    "batch": "off",
    "claude-api": "off",
    "code-review": "off",
    "deep-research": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "loop": "off",
    "plan": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs git add -N 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "cc-statusline",
    "padding": 0
  },
  "enabledPlugins": {
    ...notify_plugins,
    "claude-md-management@claude-plugins-official": true,
    "harness@agents": true,
    "millstrand-identity@harnesses": true,
    "devflow@agents": false,
    "coding@agents": true,
    "claude-code-knowledge@claude-code-plugins": true,
    "dev@claude-code-plugins": true,
    "writing@agents": true
  },
  "extraKnownMarketplaces": {
    ...notify_marketplaces,
    "agents": {
      "source": {
        "source": "directory",
        "path": env.HOME ~ "/dev/projects/agents"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "directory",
        "path": env.HOME ~ "/dev/projects/claude-code-plugins"
      }
    },
    "harnesses": {
      "source": {
        "source": "directory",
        "path": env.HOME ~ "/dev/projects/millhouse.spool/spools/harnesses"
      }
    }
  },
  "outputStyle": "Proactive",
  "spinnerTipsEnabled": false,
  "ultracode": false,
  "fastMode": false,
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "disableAutoMode": "disable",
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": false,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "feedbackSurveyRate": 0,
  "awaySummaryEnabled": false
} %}
{% set overlay = env.HOME ~ "/.config/claude/settings-overlay.json" %}
{% if overlay is not file %}{% set overlay = "/dev/null" %}{% endif %}
{# Overlays deep-merge, except permission lists, which combine so overlays list only their additions. #}
{% set merge = `($overlay[0] // {}) as $o
  | if ($overlay | length) > 1 or ($o | type) != "object" then error("Claude settings overlay must contain one JSON object") else . end
  | . as $base | . * $o
  | reduce ("allow", "ask", "deny", "additionalDirectories") as $k (.;
      if $o.permissions[$k] then .permissions[$k] = ($base.permissions[$k] + $o.permissions[$k] | unique) else . end)` %}
{{ exec(command="printf '%s' " ~ (base | json_encode | quote) ~ " | /opt/homebrew/bin/jq -Se --slurpfile overlay " ~ (overlay | quote) ~ " " ~ (merge | quote)) }}
