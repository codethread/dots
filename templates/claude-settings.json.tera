{# A repo may install a JSON overlay without owning this shared output file. #}
{% set notify_plugins = {"cc-notify@cc-notify-marketplace": true} if vars.claude_enable_notify else {} %}
{% set notify_marketplaces = {"cc-notify-marketplace": {"source": {"source": "github", "repo": "codethread/cc-notify"}}} if vars.claude_enable_notify else {} %}
{% set base = {
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "MANPAGER": "cat",
    "SHELL": exec(command="command -v bash"),
    "TMPDIR": "/tmp/claude"
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash",
      "Edit(.claude)",
      "Read(//tmp/claude/**)",
      "Edit(//tmp/claude/**)",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__context7__*"
    ],
    "deny": [
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "NotebookEdit",
      "WaitForMcpServers",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "LSP",
      "Workflow",
      "ShareOnboardingGuide",
      "DesignSync",
      "Read(**/*.key)",
      "Read(~/*.key)",
      "Read(**/*.pem)",
      "Read(~/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.git/hooks/**)",
      "Read(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Read(**/.netrc)",
      "Read(~/.netrc)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "$DOTFILES",
      "~/.local",
      "~/.claude",
      "~/dev"
    ]
  },
  "enabledMcpjsonServers": [],
  "skillOverrides": {
    "autofix-pr": "off",
    "batch": "off",
    "claude-api": "off",
    "code-review": "off",
    "deep-research": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "loop": "off",
    "plan": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs git add -N 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "cc-statusline",
    "padding": 0
  },
  "enabledPlugins": {
    ...notify_plugins,
    "claude-md-management@claude-plugins-official": true,
    "harness@agents": true,
    "devflow@agents": false,
    "coding@agents": true,
    "claude-code-knowledge@claude-code-plugins": true,
    "dev@claude-code-plugins": true,
    "writing@agents": true
  },
  "extraKnownMarketplaces": {
    ...notify_marketplaces,
    "agents": {
      "source": {
        "source": "directory",
        "path": env.HOME ~ "/dev/projects/agents"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "directory",
        "path": env.HOME ~ "/dev/projects/claude-code-plugins"
      }
    }
  },
  "outputStyle": "Proactive",
  "spinnerTipsEnabled": false,
  "ultracode": false,
  "fastMode": false,
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "disableAutoMode": "disable",
  "theme": "auto",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": false,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "in-process",
  "useAutoModeDuringPlan": false
} %}
{% set overlay = env.HOME ~ "/.config/claude/settings-overlay.json" %}
{% if overlay is file %}
{{ exec(command="printf '%s' " ~ (base | json_encode | quote) ~ " | /opt/homebrew/bin/jq -Se --slurpfile overlay " ~ (overlay | quote) ~ " 'if ($overlay | length) == 1 and ($overlay[0] | type) == \"object\" then . * $overlay[0] else error(\"Claude settings overlay must contain one JSON object\") end'") }}
{% else %}
{{ exec(command="printf '%s' " ~ (base | json_encode | quote) ~ " | /opt/homebrew/bin/jq -S .") }}
{% endif %}
