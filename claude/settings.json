{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "MANPAGER": "cat",
    "ZDOTDIR": "~/.config/zsh-claude",
    "__CC_CUSTOM_ENVS_": "manpager so we can see files, ZDOTDIR avoids old shell stuff"
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "deny": [
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "NotebookEdit",
      "Bash(git push:*)",
      "Bash(gh pr merge*)",
      "Read(**/*.key)",
      "Read(~/*.key)",
      "Read(**/*.pem)",
      "Read(~/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.git/hooks/**)",
      "Read(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Read(**/.netrc)",
      "Read(~/.netrc)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git config*)",
      "Bash(git commit --amend*)",
      "Bash(git rebase -i*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/PersonalConfigs",
      "~/.local",
      "~/.claude",
      "~/dev",
      "~/work",
      "~/workfiles"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs git add -N 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook--npm-redirect"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook--context-injector session-end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook--context-injector session-start"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cc-statusline",
    "padding": 0
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "codethread/claude-code-plugins"
      }
    },
    "cc-notify-marketplace": {
      "source": {
        "source": "github",
        "repo": "codethread/cc-notify"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "cc-notify@cc-notify-marketplace": true,
    "karen@codethread-plugins": true
  },
  "autoMemoryEnabled": false,
  "cleanupPeriodDays": 999,
  "fastMode": false,
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "promptSuggestionEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
