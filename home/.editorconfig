root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
indent_style = tab

[*.rs]
indent_style = space
indent_size = 4

# nushell (nufmt style)
[*.nu]
indent_style = space
indent_size = 4

[*.{json,js,jsx,ts,tsx,html,css,yml,sh,zsh,nix,clj,edn}]
indent_style = space
indent_size = 2

# treesitter queries indent a lot!
[*.{scm}]
indent_style = space
indent_size = 2
