root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
indent_style = tab

[*.rs]
indent_style = space
indent_size = 4

# shell
[*.{sh,zsh}]
indent_style = space
indent_size = 2

# nix (nixfmt/RFC style)
[*.nix]
indent_style = space
indent_size = 2

# web
[*.{json,js,jsx,ts,tsx,html,css,yml}]
indent_style = space
indent_size = 2

# treesitter queries indent a lot!
[*.{scm}]
indent_style = space
indent_size = 2
