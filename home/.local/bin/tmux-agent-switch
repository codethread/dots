#!/usr/bin/env bash
#:module: Tmux agentic-pane switcher
#:
#: Usage: tmux-agent-switch [--debug] [--json]
#:
#: Finds tmux panes running agentic CLIs (Claude, Codex, Pi, etc.), shows them
#: in an fzf-tmux popup with a live pane preview, and jumps to the selection.
#: Press Tab to toggle the preview between below and beside the pane list.
#:
#: Options:
#:   --debug   Print pane list and their captured content to stdout (no fzf)
#:   --json    Print discovered agent panes as a JSON array to stdout and exit
#:   -h|--help Show this help

set -u

AGENT_REGEX='(^|[^[:alnum:]_-])(claude([-/ ]code)?|@anthropic-ai/claude-code|cl|codex([-/ ]raw)?|pi|pim)([^[:alnum:]_-]|$)'

DEBUG_MODE=0
JSON_MODE=0

usage() {
	grep '^#:' "$0" | sed 's/^#: \{0,1\}//'
	exit 0
}

for arg in "$@"; do
	case "$arg" in
		--debug) DEBUG_MODE=1 ;;
		--json)  JSON_MODE=1 ;;
		-h|--help) usage ;;
	esac
done

if ! command -v tmux >/dev/null 2>&1; then
	echo 'tmux-agent-switch: tmux is required' >&2
	exit 1
fi

if [[ $DEBUG_MODE -eq 0 ]] && [[ $JSON_MODE -eq 0 ]] && ! command -v fzf-tmux >/dev/null 2>&1; then
	echo 'tmux-agent-switch: fzf-tmux is required' >&2
	exit 1
fi

if [[ $DEBUG_MODE -eq 0 ]] && [[ $JSON_MODE -eq 0 ]] && ! command -v perl >/dev/null 2>&1; then
	echo 'tmux-agent-switch: perl is required for the foreground-colour preview' >&2
	exit 1
fi

if [[ $JSON_MODE -eq 1 ]] && ! command -v jq >/dev/null 2>&1; then
	echo 'tmux-agent-switch: jq is required for --json' >&2
	exit 1
fi

if [[ -z "${TMUX:-}" ]] && ! tmux list-clients >/dev/null 2>&1; then
	echo 'tmux-agent-switch: no running tmux client found' >&2
	exit 1
fi

declare -a PROCESS_ARGS PROCESS_GROUP TERMINAL_GROUP

snapshot_processes() {
	local pid pgid tpgid args
	while read -r pid pgid tpgid args; do
		PROCESS_ARGS[$pid]=$args
		PROCESS_GROUP[$pid]=$pgid
		TERMINAL_GROUP[$pid]=$tpgid
	done < <(ps -axo pid=,pgid=,tpgid=,args=)
}

agent_label() {
	local exec=$1
	local args=$2

	if [[ "$exec" == "agent" ]] || [[ "$args" =~ cursor-agent ]]; then
		AGENT_LABEL='cursor'
	elif [[ "$exec" == "pi" || "$exec" == "pim" ]] || [[ "$args" =~ (^|[[:space:]])(pi|pim)([[:space:]]|$) ]]; then
		AGENT_LABEL='pi'
	elif [[ "$exec" == "codex" || "$exec" == "codex-raw" ]] || [[ "$args" =~ codex ]]; then
		AGENT_LABEL='codex'
	elif [[ "$exec" == "claude" || "$exec" == "cl" ]] || [[ "$args" =~ claude([-/ ]code)? ]] || [[ "$args" =~ @anthropic-ai/claude-code ]]; then
		AGENT_LABEL='claude'
	else
		AGENT_LABEL=$exec
	fi
}

# Inspect the pane's foreground process group rather than only its direct child.
# Programmatic launchers commonly add several shell layers before the agent CLI.
find_agent_process() {
	local pane_pid=$1
	local foreground_group=${TERMINAL_GROUP[$pane_pid]:-}
	local pid args exec rank best_rank=0 best_pid=0

	MATCH_EXEC=''
	MATCH_ARGS=''
	[[ -z "$foreground_group" ]] && return 1

	for pid in "${!PROCESS_ARGS[@]}"; do
		[[ "${PROCESS_GROUP[$pid]:-}" == "$foreground_group" ]] || continue
		args=${PROCESS_ARGS[$pid]}
		exec=${args%% *}
		exec=${exec##*/}

		if [[ "$exec" =~ ^(claude|cl|codex|codex-raw|pi|pim)$ ]]; then
			rank=4
		elif [[ "$exec" == 'agent' ]]; then
			rank=3
		elif [[ "$args" =~ $AGENT_REGEX ]] || [[ "$args" =~ cursor-agent ]]; then
			rank=2
		else
			continue
		fi

		if (( rank > best_rank || (rank == best_rank && pid > best_pid) )); then
			best_rank=$rank
			best_pid=$pid
			MATCH_EXEC=$exec
			MATCH_ARGS=$args
		fi
	done

	[[ -n "$MATCH_ARGS" ]]
}

# Outputs one line per matching pane:
#   <active>\x1f<session>\x1f<window_name>\x1f<tool>\x1f<path>\t<pane_id>\t<window_target>
#
# Fields within the display block use \x1f (ASCII unit separator) so the
# delimiter cannot collide with session/window names or filesystem paths.
list_agent_panes() {
	local pane_format
	snapshot_processes
	pane_format=$'#{session_name}\t#{window_index}\t#{window_name}\t#{pane_index}\t#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_active}\t#{pane_tty}\t#{pane_title}'
	while IFS=$'\t' read -r session_name window_index window_name pane_index pane_id pane_pid pane_current_command pane_current_path pane_active pane_tty pane_title; do
		local tool active_mark short_path
		find_agent_process "$pane_pid" || continue

		agent_label "$MATCH_EXEC" "$MATCH_ARGS"
		tool=$AGENT_LABEL

		active_mark=' '
		[[ "$pane_active" == '1' ]] && active_mark='*'

		short_path="${pane_current_path/#$HOME/\~}"

		printf $'%s\x1f%s\x1f%s\x1f%s\x1f%s\t%s\t%s\n' \
			"$active_mark" \
			"$session_name" \
			"$window_name" \
			"$tool" \
			"$short_path" \
			"$pane_id" \
			"$session_name:$window_index"
	done < <(tmux list-panes -a -F "$pane_format")
}

# Reads pipe-delimited structured lines from list_agent_panes and re-emits
# them with columns padded to the same width across all rows.
align_candidates() {
	local lines=()
	while IFS= read -r line; do
		lines+=("$line")
	done

	[[ ${#lines[@]} -eq 0 ]] && return

	local max_session=0 max_window=0 max_tool=0
	local display_part active session window tool path display_tool
	for line in "${lines[@]}"; do
		display_part="${line%%$'\t'*}"
		IFS=$'\x1f' read -r active session window tool path <<< "$display_part"
		display_tool="$tool"
		[[ "$session" =~ ^pandora--([^_]+)__(.+)$ ]] && display_tool="${BASH_REMATCH[1]}"
		[[ ${#session}      -gt $max_session ]] && max_session=${#session}
		[[ ${#window}       -gt $max_window  ]] && max_window=${#window}
		[[ ${#display_tool} -gt $max_tool    ]] && max_tool=${#display_tool}
	done

	local label rest
	for line in "${lines[@]}"; do
		rest="${line#*$'\t'}"
		display_part="${line%%$'\t'*}"
		IFS=$'\x1f' read -r active session window tool path <<< "$display_part"
		display_tool="$tool"
		[[ "$session" =~ ^pandora--([^_]+)__(.+)$ ]] && display_tool="${BASH_REMATCH[1]}"
		label=$(printf '%s  %-*s  %-*s  %-*s  %s' \
			"$active" \
			"$max_session" "$session" \
			"$max_window"  "$window" \
			"$max_tool"    "$display_tool" \
			"$path")
		printf '%s\t%s\n' "$label" "$rest"
	done
}

debug_panes() {
	local candidates="$1"
	if [[ -z "$candidates" ]]; then
		echo "No agent panes found."
		return
	fi

	echo "=== Agent panes found ==="
	echo ""
	while IFS=$'\t' read -r label pane_id window_target; do
		echo "──────────────────────────────────────────"
		echo "LABEL:   $label"
		echo "PANE_ID: $pane_id"
		echo "TARGET:  $window_target"
		echo "PREVIEW (tmux capture-pane -ep -t $pane_id) — last 20 lines:"
		echo "┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄"
		tmux capture-pane -ep -t "$pane_id" 2>/dev/null | tail -20
		echo ""
	done <<< "$candidates"
}

json_panes() {
	local raw
	raw=$(list_agent_panes)

	if [[ -z "$raw" ]]; then
		printf '[]\n'
		return
	fi

	local objects=()
	while IFS=$'\t' read -r display_part pane_id window_target; do
		local active_mark session window tool path active_bool preview session_type envy_repo
		IFS=$'\x1f' read -r active_mark session window tool path <<< "$display_part"
		active_bool='false'
		[[ "$active_mark" == '*' ]] && active_bool='true'
		if [[ "$session" =~ ^pandora--([^_]+)__(.+)$ ]]; then
			session_type='envy'
			envy_repo="${BASH_REMATCH[2]}"
		elif [[ "$session" == *'__'* ]]; then
			session_type='worktree'
			envy_repo=''
		else
			session_type='canonical'
			envy_repo=''
		fi
		preview=$(tmux capture-pane -p -t "$pane_id" 2>/dev/null \
			| grep -v '^[─━═ 	]*$' \
			| grep -v '^[[:space:]]*--[[:space:]]' \
			| tail -20)
		objects+=("$(jq -n \
			--arg session "$session" \
			--arg window "$window" \
			--arg tool "$tool" \
			--arg path "$path" \
			--arg pane_id "$pane_id" \
			--arg window_target "$window_target" \
			--argjson active "$active_bool" \
			--arg preview "$preview" \
			--arg session_type "$session_type" \
			--arg envy_repo "$envy_repo" \
			'{session:$session,window:$window,tool:$tool,path:$path,pane_id:$pane_id,window_target:$window_target,active:$active,preview:$preview,session_type:$session_type,envy_repo:$envy_repo}')")
	done <<< "$raw"

	printf '%s\n' "${objects[@]}" | jq -s '.'
}

main() {
	if [[ $JSON_MODE -eq 1 ]]; then
		json_panes
		exit 0
	fi

	local candidates selected pane_id window_target
	candidates=$(list_agent_panes | align_candidates)

	if [[ $DEBUG_MODE -eq 1 ]]; then
		debug_panes "$candidates"
		exit 0
	fi

	if [[ -z "$candidates" ]]; then
		tmux display-message "No running agentic tools found"
		exit 0
	fi

	# Parse tmux's SGR parameters as colour groups so RGB/palette values that
	# happen to equal background codes are preserved. Disable inverse too.
	local preview_command
	preview_command=$(cat <<'PREVIEW'
tmux capture-pane -ep -t {2} | perl -pe '
	s{\e\[([0-9;]*)m}{
		my @codes = $1 =~ /(?:38|48|58);(?:5;\d+|2;\d+;\d+;\d+)|\d+/g;
		@codes = map {
			/^(?:4[0-9]|10[0-7]|48;.*)$/ ? 49 : $_ eq "7" ? 27 : $_
		} @codes;
		"\e[" . join(";", @codes) . "m"
	}ge;
'
PREVIEW
	)
	# Follow opens at the newest output even when the pane is taller than the preview.
	selected=$(printf '%s\n' "$candidates" \
		| fzf-tmux -p -w 90% -h 80% \
			--prompt='Agents > ' \
			--layout=reverse-list \
			--delimiter=$'\t' \
			--with-nth=1 \
			--preview="$preview_command" \
			--preview-window='down,70%,nowrap,follow' \
			--bind 'enter:accept,tab:change-preview-window(right,70%|down,70%)') || exit 0

	pane_id=$(printf '%s' "$selected" | cut -f2)
	window_target=$(printf '%s' "$selected" | cut -f3)

	tmux switch-client -t "$window_target"
	tmux select-pane -t "$pane_id"
}

main "$@"
