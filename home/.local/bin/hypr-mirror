#!/usr/bin/env bash
# :module: hypr-mirror
# Toggle mirror mode: collapse browsers + terminals to one workspace.
# Use when SSHing in to monitor long-running processes (e.g. claude code).
#
# Enter: moves Chrome/Brave from alt → primary, overrides rules for new windows
# Exit:  reloads Hyprland config to restore original workspace assignments
#        NOTE: reload also resets any other runtime hyprctl keyword changes in the session
#
# Usage:
#   hypr-mirror        # toggle on/off
#   hypr-mirror -h     # show this help

set -euo pipefail

# Auto-discover instance signature when not set (e.g. when running over SSH)
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    _hypr_dir="/run/user/$UID/hypr"
    mapfile -t _sigs < <(ls "$_hypr_dir" 2>/dev/null)
    if [[ ${#_sigs[@]} -eq 0 ]]; then
        echo "error: no running Hyprland instance found" >&2; exit 1
    elif [[ ${#_sigs[@]} -gt 1 ]]; then
        echo "error: multiple Hyprland instances found, set HYPRLAND_INSTANCE_SIGNATURE explicitly" >&2; exit 1
    fi
    export HYPRLAND_INSTANCE_SIGNATURE="${_sigs[0]}"
fi

# Scoped to user + Hyprland instance to avoid collisions across sessions/users
STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr-mirror-${HYPRLAND_INSTANCE_SIGNATURE}.state"
TARGET="primary"

# Classes to migrate; must match the windowrule overrides below
BROWSER_CLASS_RE='^([Gg]oogle-chrome|[Bb]rave-browser)$'

usage() {
    grep '^#' "$0" | grep -v '!/usr/bin' | sed 's/^# \?//'
    exit 0
}

enter_mirror_mode() {
    # Move Chrome/Brave windows from alt to primary (silent = no focus switch per window)
    # Filter by both workspace and class to avoid displacing unrelated alt windows
    hyprctl clients -j | jq -r --arg re "$BROWSER_CLASS_RE" \
        '.[] | select(.workspace.name == "alt" and (.class | test($re))) | .address' | \
        while IFS= read -r addr; do
            hyprctl dispatch movetoworkspacesilent "name:$TARGET,address:$addr"
        done

    # Override rules so new Chrome/Brave windows also open on primary
    hyprctl keyword windowrule "workspace name:primary silent, match:class ^([Gg]oogle-chrome)$"
    hyprctl keyword windowrule "workspace name:primary silent, match:class ^([Bb]rave-browser)$"

    # Scale up for 720p viewing: 1080p at 1.5x = 720p logical resolution
    hyprctl keyword monitor "eDP-1,preferred,0x0,1.5"

    hyprctl dispatch workspace "name:$TARGET"

    echo "on" > "$STATE_FILE"
    notify-send -u low "Mirror mode ON" "Browsers + terminals on $TARGET" || true

    # Kill existing kitty processes: TERM first, then KILL survivors after a grace period
    # NOTE: must be last — if run from kitty, this kills the script's own process
    mapfile -t _kitty_pids < <(hyprctl clients -j | jq -r '.[] | select(.class == "kitty") | .pid')
    if [[ ${#_kitty_pids[@]} -gt 0 ]]; then
        kill -TERM "${_kitty_pids[@]}" 2>/dev/null || true
        sleep 0.3
        kill -KILL "${_kitty_pids[@]}" 2>/dev/null || true
    fi
    hyprctl dispatch exec "kitty tmux attach -t main"
}

exit_mirror_mode() {
    # Restore original monitor scale
    hyprctl keyword monitor "eDP-1,preferred,0x0,1"

    # Reload restores original windowrules from hyprland.conf
    hyprctl reload

    rm -f "$STATE_FILE"
    notify-send -u low "Mirror mode OFF" "Workspace rules restored" || true
}

case "${1:-}" in
    -h|--help) usage ;;
esac

if [[ -f "$STATE_FILE" ]]; then
    exit_mirror_mode
else
    enter_mirror_mode
fi
