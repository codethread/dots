#!/usr/bin/env bash
# :module: Minimal Pi review wrapper

set -euo pipefail

usage() {
  echo 'Usage: code-review [--deep] "your review prompt"' >&2
}

pi_args=(--agent review)

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --deep)
      pi_args+=(--thinking high)
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

prompt="$*"

echo "$prompt" \
  | pi "${pi_args[@]}"

