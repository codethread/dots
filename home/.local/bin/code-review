#!/usr/bin/env bash
# :module: Minimal Codex review wrapper

set -euo pipefail

usage() {
  echo 'Usage: code-review [--deep] "your review prompt"' >&2
}

profile="fast-review"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --deep)
      profile="deep-review"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

prompt="$*"

echo "$prompt" \
  | codex exec --json --sandbox read-only --profile "$profile" review --skip-git-repo-check - \
  | jq -rs '[.[] | select(.type=="item.completed" and .item.type=="agent_message") | .item.text] | last // ""'
