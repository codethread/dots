#!/usr/bin/env bash
# :module: Minimal Codex review wrapper

set -euo pipefail

usage() {
  echo 'Usage: code-review "your review prompt"' >&2
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

prompt="$*"

echo "$prompt" \
  | codex exec --json --sandbox read-only review - \
  | jq -rs '[.[] | select(.type=="item.completed" and .item.type=="agent_message") | .item.text] | last // ""'
