#!/usr/bin/env bash
# :module: Starts Chrome with remote debugging for browser-devtools Claude agent.
# Idempotent - safe to call on every PreToolUse.
# Writes a session-scoped sentinel file so cc-hook--chrome-stop can clean up.

SESSION="${CLAUDE_SESSION_ID:-}"

if [ -z "$SESSION" ]; then
    echo "cc-hook--chrome-start: no CLAUDE_SESSION_ID, cannot manage Chrome lifecycle" >&2
    exit 1
fi

SENTINEL="/tmp/claude-chrome-devtools-${SESSION}.pid"
PROFILE="/tmp/claude-chrome-devtools-${SESSION}-profile"
PORT=9222
LOG="/tmp/claude-chrome-devtools-${SESSION}.log"

# If sentinel exists, check if the process is still alive
if [ -f "$SENTINEL" ]; then
    PID=$(cat "$SENTINEL")
    if kill -0 "$PID" 2>/dev/null; then
        # Chrome still running for this session
        exit 0
    fi
    # Stale sentinel — process is dead, remove and relaunch
    rm -f "$SENTINEL"
fi

# Find Chrome binary
CHROME=""
for candidate in \
    "google-chrome" \
    "google-chrome-stable" \
    "chromium" \
    "chromium-browser" \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"; do
    if command -v "$candidate" &>/dev/null || [ -x "$candidate" ]; then
        CHROME="$candidate"
        break
    fi
done

if [ -z "$CHROME" ]; then
    echo "cc-hook--chrome-start: no Chrome binary found" >&2
    exit 1
fi

# Isolated profile per session avoids macOS singleton behavior ignoring our flags
"$CHROME" \
    --remote-debugging-port="$PORT" \
    --remote-debugging-address=127.0.0.1 \
    --user-data-dir="$PROFILE" \
    --no-first-run \
    --no-default-browser-check \
    --disable-background-networking \
    &>"$LOG" &

CHROME_PID=$!
echo "$CHROME_PID" > "$SENTINEL"

# Give Chrome a moment to bind the port
sleep 2

exit 0
