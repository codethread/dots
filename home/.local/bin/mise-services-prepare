#!/bin/bash
# :module: Prepare cc-notify and Git maintenance before mise loads their LaunchAgents.
set -euo pipefail

case "${1:-}" in
  -h|--help)
    echo 'Usage: mise -E <dev|work> run services:prepare (from the dotfiles repository)'
    exit 0
    ;;
  '') ;;
  *) echo "Unexpected argument: $1" >&2; exit 2 ;;
esac
[ "$(uname -s)" = Darwin ] || { echo 'These services require macOS' >&2; exit 1; }
: "${GIT_MAINTENANCE_REPOSITORIES:?Select a dev or work mise profile}"

repo="$HOME/dev/projects/cc-notify"
if [ ! -e "$repo" ]; then
  mkdir -p "$(dirname "$repo")"
  GIT_SSH_COMMAND='/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=5' \
    /usr/bin/git clone git@github.com:codethread/cc-notify.git "$repo"
fi
/usr/bin/git -C "$repo" rev-parse --git-dir >/dev/null
cd "$repo"
bun install --frozen-lockfile
# Bun loads this checkout's .env. Report missing names, never credential values.
bun -e 'for (const key of ["PUSHOVER_CC_KEY", "PUSHOVER_DEV_KEY"]) {
  if (!process.env[key]) throw new Error(`Missing ${key}: configure cc-notify .env before applying services`);
}'

mkdir -p "$HOME/.local/state/com.codethread.cc-notify" \
  "$HOME/.local/state/com.codethread.git-maintenance"
