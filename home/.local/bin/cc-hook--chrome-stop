#!/usr/bin/env bash
# :module: Stops Chrome started by cc-hook--chrome-start for browser-devtools Claude agent.
# Reads the session-scoped sentinel file to find the PID to kill.
# Validates that the PID is actually the Chrome process we launched (session profile path)
# before killing, to avoid killing an unrelated process with a recycled PID.

SESSION="${CLAUDE_SESSION_ID:-}"

if [ -z "$SESSION" ]; then
    echo "cc-hook--chrome-stop: no CLAUDE_SESSION_ID, skipping" >&2
    exit 0
fi

SENTINEL="/tmp/claude-chrome-devtools-${SESSION}.pid"
PROFILE="/tmp/claude-chrome-devtools-${SESSION}-profile"

[ -f "$SENTINEL" ] || exit 0

PID=$(cat "$SENTINEL")

if kill -0 "$PID" 2>/dev/null; then
    # Validate the process is the Chrome we launched by checking its cmdline contains our profile
    CMDLINE=$(ps -p "$PID" -o args= 2>/dev/null || cat "/proc/$PID/cmdline" 2>/dev/null | tr '\0' ' ')
    if echo "$CMDLINE" | grep -q "$PROFILE"; then
        kill "$PID"
    else
        echo "cc-hook--chrome-stop: PID $PID does not match expected Chrome session profile, skipping kill" >&2
    fi
fi

rm -f "$SENTINEL"
exit 0
