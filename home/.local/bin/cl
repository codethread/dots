#!/usr/bin/env bash
# :module: Claude Code launcher with shared defaults and override flags
#
# The one entrypoint for people and tooling; shells only add shortcuts.
# Defaults: skip permission prompts, `pairing` output style for interactive
# sessions, no MCP servers unless chosen with --mcp (--strict-mcp-config),
# claude.ai connectors off (shared settings.json), Artifact and agent tools off
# (both are one-way, so cl sets them per session), and an appended forge prompt.
# Other arguments pass to `claude`.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: cl [cl options] [claude options] [prompt]
       cl <claude subcommand> ...      (passed through untouched)

cl options:
  -s, --safe                  keep permission prompts (default: skip them)
      --mcp <name|json|file>  load an MCP server; repeatable (default: none)
                              known names: figma, context7
      --mcp-all               load every configured MCP server (no --strict-mcp-config)
      --mcp-work              enable claude.ai connectors (Atlassian, Microsoft 365, ...);
                              implies --mcp-all, as strict mode drops connectors
      --artifact              enable the Artifact tool (default: off)
      --agent-tool            enable the Agent and ListAgents tools (default: off)
  -m, --mine                  use the personal config dir ~/.config/claude
      --output-style <style>  session output style (default: pairing, unless --print)
      --thinking <level>      set Claude's effort (low, medium, high, xhigh, max)
      --settings <json|file>  session settings, merged with cl's own
      --append-system-prompt <prompt>
                              appended after cl's prompts
      --dry-run               print the claude command instead of running it
  -h, --help                  show this help and claude's

EOF
}

known_mcp() {
    case $1 in
        figma) echo '{"mcpServers":{"figma":{"type":"http","url":"https://mcp.figma.com/mcp"}}}' ;;
        context7) echo '{"mcpServers":{"context7":{"type":"stdio","command":"bunx","args":["@upstash/context7-mcp"]}}}' ;;
        *) return 1 ;;
    esac
}

case ${1:-} in
    agents|attach|auth|auto-mode|doctor|gateway|import|install|logs|mcp|plugin|plugins|purge|respawn|rm|setup-token|stop|kill|ultrareview|update|upgrade)
        exec claude "$@" ;;
esac

safe=0 mcp_work=0 mcp_all=0 artifact=0 agent_tool=0 printing=0 dry_run=0 style='' settings='{}' user_prompt=''
args=() mcps=()
while (($#)); do
    case $1 in
        --settings=*|--output-style=*|--append-system-prompt=*|--thinking=*|--mcp=*)
            set -- "${1%%=*}" "${1#*=}" "${@:2}"; continue ;;
        -s|--safe) safe=1 ;;
        --mcp-work) mcp_work=1 ;;
        --mcp-all) mcp_all=1 ;;
        --mcp)
            (($# >= 2)) && [[ -n $2 ]] || { echo 'cl: --mcp requires a value' >&2; exit 2; }
            if known_mcp "$2" >/dev/null; then mcps+=("$(known_mcp "$2")")
            elif [[ -f $2 || $2 == '{'* ]]; then mcps+=("$2")
            else echo "cl: unknown MCP '$2' (known: figma, context7; or a JSON file/string)" >&2; exit 2
            fi
            shift ;;
        --artifact) artifact=1 ;;
        --agent-tool) agent_tool=1 ;;
        -m|--mine) export CLAUDE_CONFIG_DIR="$HOME/.config/claude" ;;
        --dry-run) dry_run=1 ;;
        -h|--help) usage; exec claude --help ;;
        -p|--print) printing=1; args+=("$1") ;;
        --thinking)
            (($# >= 2)) && [[ -n $2 && $2 != -* ]] || { echo 'cl: --thinking requires a value' >&2; exit 2; }
            args+=(--effort "$2")
            shift ;;
        --settings|--output-style|--append-system-prompt)
            (($# >= 2)) || { echo "cl: $1 requires a value" >&2; exit 2; }
            case $1 in
                --settings) settings=$2 ;;
                --output-style) style=$2 ;;
                *) user_prompt=$2 ;;
            esac
            shift ;;
        --) args+=("$@"); break ;;
        *) args+=("$1") ;;
    esac
    shift
done

# --settings accepts a file like claude does; cl merges it into one object.
if [[ -f $settings ]]; then
    settings=$(<"$settings")
fi
# Shared settings.json turns connectors off via env, which outranks the process
# env; only a higher-precedence settings source such as --settings re-enables them.
# Artifact is the reverse: enableArtifact=false cannot be undone by any higher
# source, so it is set here unless --artifact is given, not in the shared file.
# permissions.deny is one-way too: no source or flag (--allowedTools, --tools)
# lifts another source's deny, so the agent tools are denied here as well.
settings=$(jq -ce --arg style "$style" --argjson printing "$printing" --argjson mcp "$mcp_work" --argjson artifact "$artifact" --argjson agent "$agent_tool" '
    (if type != "object" then error("--settings must be a JSON object or file") else . end)
    | (if $mcp == 1 then .env.ENABLE_CLAUDEAI_MCP_SERVERS = "true" else . end)
    | (if $artifact == 0 then .enableArtifact = false else . end)
    | (if $agent == 0 then .permissions.deny = ((.permissions.deny // []) + ["Agent", "ListAgents"] | unique) else . end)
    | if $style != "" then .outputStyle = $style
      elif $printing == 0 and (has("outputStyle") | not) then .outputStyle = "pairing"
      else . end
' <<<"$settings")

prompts=()
case $(git remote get-url origin 2>/dev/null || true) in
    *github.com*) prompts+=("this repo uses github (via gh)") ;;
    ?*) prompts+=("this repo uses gitlab (via glab)") ;;
esac
[[ -z $user_prompt ]] || prompts+=("$user_prompt")

cmd=(claude)
((safe)) || cmd+=(--dangerously-skip-permissions)
[[ $settings == '{}' ]] || cmd+=(--settings "$settings")
# --strict-mcp-config also drops claude.ai connectors, so --mcp-work skips it.
# --mcp-config is variadic; the = form stops it swallowing the prompt.
((mcp_all || mcp_work)) || cmd+=(--strict-mcp-config)
for mcp in "${mcps[@]}"; do cmd+=("--mcp-config=$mcp"); done
((${#prompts[@]} == 0)) || cmd+=(--append-system-prompt "$(printf '%s\n' "${prompts[@]}")")
cmd+=("${args[@]}")

if ((dry_run)); then
    [[ -z ${CLAUDE_CONFIG_DIR:-} ]] || printf 'CLAUDE_CONFIG_DIR=%q ' "$CLAUDE_CONFIG_DIR"
    printf '%q ' "${cmd[@]}"
    echo
    exit 0
fi

exec "${cmd[@]}"
