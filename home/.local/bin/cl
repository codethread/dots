#!/usr/bin/env bash
# :module: Claude Code wrapper with conditional system prompts
#
# Appends context-aware system prompts based on environment:
#   - work repos (path contains /work/) get gitlab hint
#   - all other repos get github hint
#   - CC_SANDBOX env triggers container-awareness prompt
#   - concurrency and conciseness prompts always included

set -euo pipefail

# --- Prompt snippets ---
PROMPT_PERSONAL="this repo uses github (via gh)"
PROMPT_SANDBOX="You are running inside a container. If a required tool or binary is missing, stop immediately and tell the user rather than searching for alternatives."
PROMPT_CONCURRENCY="Sub-agent concurrency: spawn multiple read-only agents freely (explore, research, etc), but only ever one mutating agent at a time. Don't run read-only agents alongside a mutating agent — they may read stale data."
PROMPT_CONCISE="When reporting information, be extremely concise and sacrifice grammar for sake of concision."

# --- Parse flags ---
DANGEROUSLY_SKIP=false
DRY_RUN=false
PASSTHROUGH=()
MODEL=""
HAS_EFFORT=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dangerously-skip-permissions) DANGEROUSLY_SKIP=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help)
            echo "Usage: cl [-d|--dangerously-skip-permissions] [--dry-run] [-- claude-args...]"
            exit 0 ;;
        --model|-m) [[ $# -lt 2 ]] && { echo "cl: $1 requires an argument" >&2; exit 1; }; MODEL="$2"; PASSTHROUGH+=("$1" "$2"); shift 2 ;;
        --model=*) MODEL="${1#*=}"; PASSTHROUGH+=("$1"); shift ;;
        --effort) [[ $# -lt 2 ]] && { echo "cl: $1 requires an argument" >&2; exit 1; }; HAS_EFFORT=true; PASSTHROUGH+=("$1" "$2"); shift 2 ;;
        --effort=*) HAS_EFFORT=true; PASSTHROUGH+=("$1"); shift ;;
        *) PASSTHROUGH+=("$1"); shift ;;
    esac
done

# --- Build args ---
ARGS=()
if [[ "$DANGEROUSLY_SKIP" == true ]]; then
    ARGS+=(--dangerously-skip-permissions)
fi

# --- Default effort per model ---
if [[ "$HAS_EFFORT" == false ]]; then
    case "$MODEL" in
        opus*|claude-opus*) ARGS+=(--effort high) ;;
        *)                  ARGS+=(--effort medium) ;;
    esac
fi

# --- Build prompts ---
CWD="${CC_HOST_PWD:-$PWD}"
PROMPTS=()

if [[ ! "$CWD" == */work/* ]]; then
    PROMPTS+=("$PROMPT_PERSONAL")
fi

PROMPTS+=("$PROMPT_CONCURRENCY")
PROMPTS+=("$PROMPT_CONCISE")

if [[ -n "${CC_SANDBOX:-}" ]]; then
    PROMPTS+=("$PROMPT_SANDBOX")
fi

if [[ ${#PROMPTS[@]} -gt 0 ]]; then
    JOINED="$(printf '%s\n' "${PROMPTS[@]}")"
    ARGS+=(--append-system-prompt "$JOINED")
fi

ARGS+=("${PASSTHROUGH[@]}")

if [[ "$DRY_RUN" == true ]]; then
    printf '%s\n' "${ARGS[@]}"
    exit 0
fi

if [[ -n "${TMUX:-}" ]]; then
    export CLAUDE_CODE_NO_FLICKER=1
fi

exec claude "${ARGS[@]}"
