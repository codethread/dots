#!/usr/bin/env bash
# :module: Upload Caddy root CA cert to a private GitHub gist for device trust install

set -euo pipefail

CERT="/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt"

if ! sudo test -f "$CERT"; then
  echo "Caddy root cert not found at $CERT" >&2
  echo "Is Caddy running with tls internal?" >&2
  exit 1
fi

OUTFILE="/tmp/caddy-root.crt"
sudo install -m 644 -o "$(id -u)" -g "$(id -g)" "$CERT" "$OUTFILE"

URL=$(gh gist create --public=false --desc "Caddy local CA root cert" "$OUTFILE" 2>&1)

echo ""
echo "Gist created: $URL"
echo ""
echo "Open the raw file URL on your device, then:"
echo "  macOS: open .crt → Keychain Access → Trust → Always Trust"
echo "  iOS:   open in Safari → Install Profile → Settings → General → About → Certificate Trust Settings → enable"
