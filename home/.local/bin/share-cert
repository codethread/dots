#!/usr/bin/env bash
# :module: Serve Caddy root CA cert over HTTP for iOS trust install

set -euo pipefail

CERT="/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt"
PORT=8888

if ! sudo test -f "$CERT"; then
  echo "Caddy root cert not found at $CERT" >&2
  echo "Is Caddy running with tls internal?" >&2
  exit 1
fi

LAN_IP=$(ip -4 route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
if [[ -z "$LAN_IP" ]]; then
  echo "Could not determine LAN IP" >&2
  exit 1
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

sudo install -m 644 -o "$(id -u)" -g "$(id -g)" "$CERT" "$TMPDIR/root.crt"

echo ""
echo "Cert available at: http://${LAN_IP}:${PORT}/root.crt"
echo ""
echo "iOS: open URL in Safari → Install Profile → Settings → General → About → Certificate Trust Settings → enable"
echo "Press Ctrl+C to stop"
echo ""

bun -e "Bun.serve({port:${PORT},fetch(req){const f=Bun.file('${TMPDIR}/root.crt');return f.exists().then(ok=>ok?new Response(f,{headers:{'content-type':'application/x-x509-ca-cert'}}):new Response('Not found',{status:404}))}})"
