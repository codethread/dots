#!/usr/bin/env bash
# :module: Render the Codex usage cache maintained by the mise daemon.
set -euo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: tmux-codex-usage [-h|--help]

Read /tmp/tmux-codex-usage.${UID}.cache and print a coloured tmux status segment.
The codex-usage mise daemon refreshes it once per minute.
EOF
    exit 0
    ;;
  "") ;;
  *) printf 'Usage: tmux-codex-usage [-h|--help]\n' >&2; exit 2 ;;
esac

cache_file="/tmp/tmux-codex-usage.${UID}.cache"
[[ -f "$cache_file" ]] || exit 0
percentage=$(<"$cache_file")
if ! [[ "$percentage" =~ ^[0-9]+$ ]] || (( percentage > 100 )); then
  printf 'Invalid Codex usage cache: %s\n' "$cache_file" >&2
  exit 1
fi

colour="green"
(( percentage <= 10 )) && colour="colour214"
(( percentage <= 3 )) && colour="red"
printf '#[fg=%s]codex: %s%%#[default]' "$colour" "$percentage"
