#!/usr/bin/env bash
# :module: Switch macOS and terminal color theme
# Usage: theme [--family tokyonight|rose-pine] [light|dark|toggle]

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
MODE_FILE="$STATE_DIR/color-theme"
FAMILY_FILE="$STATE_DIR/color-theme-family"
DEFAULT_FAMILY="tokyonight"
KITTY_THEMES="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes"
ACTIVE_THEME_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes/active.conf"
KITTY_SOCKET="unix:/tmp/mykitty"
BG_DIR="${CT_BACKGROUNDS_DIR:-$HOME/sync/images/backgrounds}"

usage() {
  echo "Usage: theme [--family tokyonight|rose-pine] [light|dark|toggle]"
  echo "       theme                         # show current theme"
  echo "       theme --family rose-pine      # switch family, keep current mode"
}

is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

state_mode() {
  local mode

  if [[ -r "$MODE_FILE" ]]; then
    mode="$(tr -d '[:space:]' < "$MODE_FILE")"
    case "$mode" in
      light | dark)
        echo "$mode"
        return 0
        ;;
    esac
  fi

  return 1
}

system_mode() {
  local dark_mode

  if ! is_macos || ! command -v osascript >/dev/null 2>&1; then
    return 1
  fi

  dark_mode="$(osascript -e 'tell app "System Events" to tell appearance preferences to get dark mode' 2>/dev/null)"
  case "$dark_mode" in
    true)
      echo "dark"
      ;;
    false)
      echo "light"
      ;;
    *)
      return 1
      ;;
  esac
}

current_mode() {
  system_mode || state_mode || echo "dark"
}

state_family() {
  local family

  if [[ -r "$FAMILY_FILE" ]]; then
    family="$(tr -d '[:space:]' < "$FAMILY_FILE")"
    case "$family" in
      tokyonight | rose-pine)
        echo "$family"
        return 0
        ;;
    esac
  fi

  return 1
}

current_family() {
  state_family || echo "$DEFAULT_FAMILY"
}

theme_name() {
  local family="$1"
  local mode="$2"

  case "$family:$mode" in
    tokyonight:light)
      echo "tokyonight-day"
      ;;
    tokyonight:dark)
      echo "tokyonight-moon"
      ;;
    rose-pine:light)
      echo "rose-pine-dawn"
      ;;
    rose-pine:dark)
      echo "rose-pine"
      ;;
    *)
      echo "Unsupported theme: $family $mode" >&2
      return 1
      ;;
  esac
}

find_wallpaper() {
  local name="$1"
  local ext
  for ext in jpg png; do
    if [[ -f "$BG_DIR/$name.$ext" ]]; then
      echo "$BG_DIR/$name.$ext"
      return 0
    fi
  done
  return 1
}

wallpaper_path() {
  local family="$1"
  local mode="$2"
  local name

  name="$(theme_name "$family" "$mode")"
  find_wallpaper "$name" && return 0

  find_wallpaper "default"
}

set_system_mode() {
  local mode="$1"
  local dark_mode

  if ! is_macos; then
    return 0
  fi

  if [[ "$mode" == "dark" ]]; then
    dark_mode="true"
  else
    dark_mode="false"
  fi

  osascript -e "tell app \"System Events\" to tell appearance preferences to set dark mode to $dark_mode" >/dev/null
}

set_wallpaper() {
  local wallpaper="$1"

  if ! is_macos; then
    return 0
  fi

  osascript - "$wallpaper" <<'APPLESCRIPT' >/dev/null
on run argv
  set wallpaperPath to item 1 of argv
  tell application "System Events"
    repeat with currentDesktop in desktops
      set picture of currentDesktop to wallpaperPath
    end repeat
  end tell
end run
APPLESCRIPT
}

MODE_ARG=""
FAMILY=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --family)
      shift
      if [[ $# -eq 0 ]]; then
        echo "Missing family after --family" >&2
        exit 1
      fi
      FAMILY="$1"
      ;;
    light | dark | toggle)
      if [[ -n "$MODE_ARG" ]]; then
        echo "Only one mode may be provided" >&2
        exit 1
      fi
      MODE_ARG="$1"
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ -z "$MODE_ARG" && -z "$FAMILY" ]]; then
  echo "Current: $(current_family) $(current_mode)"
  usage
  exit 0
fi

FAMILY="${FAMILY:-$(current_family)}"
case "$FAMILY" in
  tokyonight | rose-pine) ;;
  *)
    echo "Unsupported theme family: $FAMILY" >&2
    exit 1
    ;;
esac

case "$MODE_ARG" in
  "")
    MODE="$(current_mode)"
    ;;
  light | dark)
    MODE="$MODE_ARG"
    ;;
  toggle)
    if [[ "$(current_mode)" == "dark" ]]; then
      MODE="light"
    else
      MODE="dark"
    fi
    ;;
esac

THEME_NAME="$(theme_name "$FAMILY" "$MODE")"
THEME_CONF="$KITTY_THEMES/$THEME_NAME.conf"
WALLPAPER="$(wallpaper_path "$FAMILY" "$MODE" || true)"

if [[ ! -f "$THEME_CONF" ]]; then
  echo "Missing kitty theme: $THEME_CONF" >&2
  exit 1
fi

if is_macos && [[ -z "$WALLPAPER" ]]; then
  echo "Missing wallpaper for: $FAMILY $MODE in $BG_DIR" >&2
  exit 1
fi

mkdir -p "$STATE_DIR" "$(dirname "$ACTIVE_THEME_CONF")"
set_system_mode "$MODE"
set_wallpaper "$WALLPAPER"
echo "$MODE" > "$MODE_FILE"
echo "$FAMILY" > "$FAMILY_FILE"
cp "$THEME_CONF" "$ACTIVE_THEME_CONF"

# reload live kitty instances; silence errors if no instance is running
if command -v kitty >/dev/null 2>&1; then
  kitty @ --to "$KITTY_SOCKET" set-colors --all --configured "$THEME_CONF" 2>/dev/null \
    || kitty @ set-colors --all --configured "$THEME_CONF" 2>/dev/null \
    || true
fi

echo "Theme: $FAMILY $MODE"
