#!/usr/bin/env nu
# :module: Compact tmux status segment for local PDX/Pithos activity.

const ACTIVE_STATUSES = ["claimed" "running"]
const GRAPH_STATUSES = ["queued" "claimed" "running"]

def usage [] {
    print "Usage: pdx-tmux-status [-h|--help]"
    print ""
    print "Print a compact PDX status segment for tmux status-right."
    print ""
    print "Data source:"
    print "  pithos graph inspect --all --status queued --status claimed --status running --json"
    print ""
    print "Semantics:"
    print "  󰴭 N    active Greed design/review tasks"
    print "  󰔟 N    active Toil triage tasks"
    print "  󰓥 N    active War execute tasks"
    print "  󰇥 N    active Envy intake/clarify tasks"
    print "  ⚠ Pn   open escalation tasks needing Pandora/user attention"
}


def cache-path [cache_dir: string] {
    let key = ([
        ($env.PDX_DATA_DIR? | default "")
        ($env.PITHOS_DB? | default "")
        ($env.PDX_USER_DATA_DIR? | default "")
    ] | str join "\n" | hash md5)

    [$cache_dir $"pdx-tmux-status.($key).cache"] | path join
}


def read-cache [path: string, ttl_seconds: int] {
    if not ($path | path exists) {
        return null
    }

    let age = (date now) - (ls $path | get 0.modified)
    if $age >= ($ttl_seconds | into duration --unit sec) {
        return null
    }

    open --raw $path
}


def save-if-possible [path: string, content: string] {
    try {
        $content | save --force $path
    } catch {
        null
    }
}


def write-error-log [path: string, stderr: string] {
    let trimmed = $stderr | str trim
    let header = $"[(date now | format date '%+')] pdx-tmux-status render failed"
    let body = if ($trimmed | is-empty) {
        $header
    } else {
        $"($header)\n($trimmed)"
    }

    save-if-possible $path $body
}


def count-by [nodes: list<any>, capabilities: list<string>, statuses: list<string>] {
    $nodes
    | where {|node|
        let capability = ($node | get -o capability | default "")
        let status = ($node | get -o status | default "")
        ($capability in $capabilities) and ($status in $statuses)
    }
    | length
}


def render-status [] {
    let result = (
        ^pithos graph inspect --all --status queued --status claimed --status running --json
        | complete
    )

    if $result.exit_code != 0 {
        return {
            ok: false
            output: ""
            stderr: ($result.stderr | str trim)
        }
    }

    try {
        let nodes = ($result.stdout | from json | get -o graph.nodes | default [])

        let greed = (count-by $nodes ["design" "review"] $ACTIVE_STATUSES)
        let toil = (count-by $nodes ["triage"] $ACTIVE_STATUSES)
        let war = (count-by $nodes ["execute"] $ACTIVE_STATUSES)
        let envy = (count-by $nodes ["intake" "clarify"] $ACTIVE_STATUSES)
        let escalations = (count-by $nodes ["escalate"] $GRAPH_STATUSES)

        let parts = [
            (if $greed > 0 { $"󰴭 ($greed)" } else { null })
            (if $toil > 0 { $"󰔟 ($toil)" } else { null })
            (if $war > 0 { $"󰓥 ($war)" } else { null })
            (if $envy > 0 { $"󰇥 ($envy)" } else { null })
            (if $escalations > 0 { $"⚠ P($escalations)" } else { null })
        ] | compact | str join "  "

        {
            ok: true
            output: $parts
            stderr: ""
        }
    } catch {|err|
        {
            ok: false
            output: ""
            stderr: ($err.msg? | default ($err | to json --raw))
        }
    }
}


def main [--help(-h)] {
    if $help {
        usage
        return
    }

    let cache_dir = ($env.TMPDIR? | default "/tmp")
    let log_path = [$cache_dir "pdx-tmux-status.log"] | path join
    let path = (cache-path $cache_dir)
    let ttl_seconds = (($env.PDX_TMUX_STATUS_TTL? | default "5") | into int)

    let cached = (read-cache $path $ttl_seconds)
    if $cached != null {
        print $cached
        return
    }

    let render = (render-status)
    if $render.ok {
        save-if-possible $path $render.output
        print $render.output
        return
    }

    write-error-log $log_path $render.stderr

    let fallback = if ($path | path exists) {
        open --raw $path
    } else {
        "?"
    }

    print $fallback
}
