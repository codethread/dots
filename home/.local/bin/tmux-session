#!/usr/bin/env bash
#:module: Tmux session switcher - numbered slots + interactive picker
#:
#: Numbered slots 0-9 are stored in a mutable state file, seeded on first
#: use from tmux/sessions.toml. Slots can be reassigned interactively.
#:
#: Usage:
#:   tmux-session [0-9]         Jump to numbered slot
#:   tmux-session --print 0-9   Print slot path (for shell cd aliases)
#:   tmux-session --assign 0-9  Assign current tmux session to numbered slot
#:   tmux-session --add         Append current tmux session to state file if missing
#:   tmux-session --seed        Re-seed slots from sessions.toml defaults
#:   tmux-session --edit        Open state file in editor popup
#:   tmux-session --list        Pick a slot via fzf and jump to it
#:   tmux-session               Interactive project discovery via fzf

set -euo pipefail

SESSIONS_TOML="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sessions.toml"
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.local/cache}/tmux-slots"

if [[ ! -f "$SESSIONS_TOML" ]]; then
	echo "Error: sessions.toml not found at $SESSIONS_TOML" >&2
	exit 1
fi

# Key 0 maps to line 10 (lines 1-9 = keys 1-9, line 10 = key 0)
key_to_line() {
	[[ "$1" == "0" ]] && echo 10 || echo "$1"
}

# ─── Profile resolution ────────────────────────────────────────────────────────

resolve_profile() {
	local hostname rules_len
	hostname=$(hostname)
	rules_len=$(fx --toml '.auto_profile.rules.length' <"$SESSIONS_TOML" 2>/dev/null || echo "0")

	for ((i = 0; i < rules_len; i++)); do
		local regex profile
		regex=$(fx --toml ".auto_profile.rules[$i].hostname_regex" <"$SESSIONS_TOML" 2>/dev/null || echo "")
		profile=$(fx --toml ".auto_profile.rules[$i].profile" <"$SESSIONS_TOML" 2>/dev/null || echo "")

		if [[ -n "$regex" ]] && [[ "$hostname" =~ $regex ]]; then
			echo "$profile"
			return
		fi

		local env_keys
		env_keys=$(fx --toml ".auto_profile.rules[$i].env" 'Object.keys(x).join("\n")' <"$SESSIONS_TOML" 2>/dev/null || echo "")
		while IFS= read -r env_key; do
			[[ -z "$env_key" ]] && continue
			local env_val
			env_val=$(fx --toml ".auto_profile.rules[$i].env.$env_key" <"$SESSIONS_TOML" 2>/dev/null || echo "")
			if [[ "${!env_key:-}" == "$env_val" ]]; then
				echo "$profile"
				return
			fi
		done <<<"$env_keys"
	done
}

_PROFILE=$(resolve_profile)

# ─── Config helpers ────────────────────────────────────────────────────────────

expand_path() {
	local p="$1"
	p="${p/#\~/$HOME}"
	p="${p//\$DOTFILES/${DOTFILES:-$HOME/dev/dots}}"
	p="${p//\$\{DOTFILES\}/${DOTFILES:-$HOME/dev/dots}}"
	echo "$p"
}

get_keys_section() {
	[[ -n "$_PROFILE" ]] && echo "profiles.$_PROFILE.keys" || echo "keys"
}

get_projects_section() {
	[[ -n "$_PROFILE" ]] && echo "profiles.$_PROFILE.projects" || echo "projects"
}

resolve_project_path_by_name() {
	local project=$1 projects_section path
	projects_section=$(get_projects_section)
	path=$(fx --toml ".$projects_section.$project" <"$SESSIONS_TOML" 2>/dev/null || echo "")
	if [[ -z "$path" ]] && [[ "$projects_section" != "projects" ]]; then
		path=$(fx --toml ".projects.$project" <"$SESSIONS_TOML" 2>/dev/null || echo "")
	fi
	[[ -n "$path" ]] && expand_path "$path" || echo ""
}

# ─── State file ────────────────────────────────────────────────────────────────

# Seed state file from sessions.toml [keys] for active profile.
# Lines 1-9 = slots 1-9, line 10 = slot 0.
seed_state() {
	local keys_section
	keys_section=$(get_keys_section)

	mkdir -p "$(dirname "$STATE_FILE")"
	local tmp
	tmp=$(mktemp)

	for num in 1 2 3 4 5 6 7 8 9 0; do
		local project path session_name
		project=$(fx --toml ".$keys_section.P$num" <"$SESSIONS_TOML" 2>/dev/null || echo "")
		if [[ -n "$project" ]]; then
			path=$(resolve_project_path_by_name "$project")
			if [[ -n "$path" ]]; then
				session_name=$(basename "$path" | tr '.' '_')
				echo "$session_name=$path" >>"$tmp"
			else
				echo "" >>"$tmp"
			fi
		else
			echo "" >>"$tmp"
		fi
	done

	mv "$tmp" "$STATE_FILE"
}

ensure_seeded() {
	mkdir -p "$(dirname "$STATE_FILE")"
	if [[ ! -f "$STATE_FILE" ]] || [[ ! -s "$STATE_FILE" ]]; then
		seed_state
	fi
}

read_slot() {
	local line
	line=$(key_to_line "$1")
	[[ -f "$STATE_FILE" ]] || return 0
	awk "NR==$line{print; exit}" "$STATE_FILE"
}

write_slot() {
	local key=$1 entry=$2
	local line
	line=$(key_to_line "$key")

	touch "$STATE_FILE"

	# Pad to 10 lines if needed
	local n
	n=$(awk 'END{print NR}' "$STATE_FILE")
	while ((n < 10)); do
		echo "" >>"$STATE_FILE"
		n=$((n + 1))
	done

	local tmp
	tmp=$(mktemp)
	awk -v line="$line" -v entry="$entry" 'NR==line{print entry; next}1' "$STATE_FILE" >"$tmp"
	mv "$tmp" "$STATE_FILE"
}

add_current_session() {
	ensure_seeded
	local current session_name
	current=$(tmux display -p '#{session_name}=#{session_path}')
	session_name=${current%%=*}

	if grep -Fxq "$current" "$STATE_FILE" || awk -F= -v name="$session_name" '$1 == name { found = 1 } END { exit !found }' "$STATE_FILE"; then
		tmux display-message "Already present: $session_name"
		return
	fi

	printf '%s\n' "$current" >>"$STATE_FILE"
	tmux display-message "Added $session_name"
}

# ─── Session switching ─────────────────────────────────────────────────────────

switch_to_project() {
	local project_path=$1
	local session_name
	session_name=$(basename "$project_path" | tr '.' '_')

	local has_clients
	has_clients=$(tmux list-clients 2>/dev/null | head -1)

	if [[ -z "$has_clients" ]] && [[ -z "${TMUX:-}" ]]; then
		exec tmux new-session -s "$session_name" -c "$project_path"
	fi

	if ! tmux has-session -t "=$session_name" 2>/dev/null; then
		tmux new-session -d -s "$session_name" -c "$project_path"
	fi

	if [[ -n "${TMUX:-}" ]] || [[ -n "$has_clients" ]]; then
		tmux switch-client -t "$session_name"
	else
		tmux attach-session -t "$session_name"
	fi
}

# ─── Interactive picker ────────────────────────────────────────────────────────

interactive_select() {
	local dirs=()
	local search_section="search"
	if [[ -n "$_PROFILE" ]]; then
		local profile_vsc
		profile_vsc=$(fx --toml ".profiles.$_PROFILE.search.vsc" <"$SESSIONS_TOML" 2>/dev/null || echo "")
		[[ -n "$profile_vsc" ]] && search_section="profiles.$_PROFILE.search"
	fi

	local vsc_json
	vsc_json=$(fx --toml ".$search_section.vsc" <"$SESSIONS_TOML" 2>/dev/null || echo "[]")
	while IFS= read -r root; do
		root=$(expand_path "$root")
		[[ -d "$root" ]] && dirs+=("$root")
	done < <(echo "$vsc_json" | fx '.map(x=>x).join("\n")')

	local static_dirs=()
	local dirs_json
	dirs_json=$(fx --toml ".$search_section.dirs" <"$SESSIONS_TOML" 2>/dev/null || echo "[]")
	while IFS= read -r d; do
		d=$(expand_path "$d")
		if [[ "$d" == *"*"* ]]; then
			for expanded in $d; do
				[[ -d "$expanded" ]] && static_dirs+=("$expanded")
			done
		else
			[[ -d "$d" ]] && static_dirs+=("$d")
		fi
	done < <(echo "$dirs_json" | fx '.map(x=>x).join("\n")')

	if [[ ${#dirs[@]} -eq 0 ]] && [[ ${#static_dirs[@]} -eq 0 ]]; then
		echo "No search directories found" >&2
		exit 1
	fi

	local selected
	selected=$({
		if [[ ${#dirs[@]} -gt 0 ]]; then
			fd -H --no-ignore '^\.git$' "${dirs[@]}" --max-depth 5 \
				-E node_modules -E target -E .cargo -E .next -E dist -E build -E coverage \
				| sed 's|/\.git$||' | sed 's|/\.git/$||'
		fi
		printf '%s\n' "${static_dirs[@]}"
	} | sort -u \
		| fzf-tmux -p -w 80% -h 70% --prompt='Select project: ') || exit 0

	[[ -n "$selected" ]] && switch_to_project "$selected"
}

# ─── Slot list/picker ──────────────────────────────────────────────────────────

list_slots() {
	ensure_seeded
	local selected
	selected=$(awk -v home="$HOME" '
		{
			if ($0 ~ /^[^=]+=/) {
				eq = index($0, "=")
				name = substr($0, 1, eq - 1)
				path = substr($0, eq + 1)
				sub(home, "~", path)
				printf "%s  %-25s %s\n", NR, name, path
			}
		}
	' "$STATE_FILE" \
		| fzf-tmux -p -w 80% -h 60% --prompt='Jump to slot: ') || exit 0

	[[ -z "$selected" ]] && exit 0
	local linenum entry
	linenum=$(echo "$selected" | awk '{print $1}')
	entry=$(awk -v n="$linenum" 'NR==n{print; exit}' "$STATE_FILE")
	[[ -z "$entry" ]] && exit 0
	switch_to_project "${entry#*=}"
}

# ─── Dispatch ──────────────────────────────────────────────────────────────────

case "${1:-}" in
[0-9])
	ensure_seeded
	slot=$(read_slot "$1")
	if [[ -z "$slot" ]]; then
		tmux display-message "Slot $1 is empty — use <prefix>h $1 to assign"
		exit 0
	fi
	switch_to_project "${slot#*=}"
	;;
--print)
	if [[ ! "${2:-}" =~ ^[0-9]$ ]]; then
		echo "Usage: tmux-session --print <number>" >&2
		exit 1
	fi
	ensure_seeded
	slot=$(read_slot "$2")
	if [[ -z "$slot" ]]; then
		echo "Error: Slot $2 is empty" >&2
		exit 1
	fi
	echo "${slot#*=}"
	;;
--assign)
	if [[ ! "${2:-}" =~ ^[0-9]$ ]]; then
		echo "Usage: tmux-session --assign <number>" >&2
		exit 1
	fi
	ensure_seeded
	current=$(tmux display -p '#{session_name}=#{session_path}')
	write_slot "$2" "$current"
	tmux display-message "Slot $2 → $(tmux display -p '#{session_name}')"
	;;
--add)
	add_current_session
	;;
--seed)
	seed_state
	tmux display-message "Slots reseeded from sessions.toml (profile: ${_PROFILE:-default})" 2>/dev/null || \
		echo "Seeded $STATE_FILE (profile: ${_PROFILE:-default})"
	;;
--edit)
	exec tmux popup -E "NVIM_APPNAME=minimal-nvim ${EDITOR:-nvim} $STATE_FILE"
	;;
--list)
	list_slots
	;;
*)
	interactive_select
	;;
esac
